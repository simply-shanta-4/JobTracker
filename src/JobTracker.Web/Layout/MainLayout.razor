@inherits LayoutComponentBase

<NavMenu />

<main class="container py-4">
    <ErrorBoundary>
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="alert alert-danger">
            <pre style="white-space: pre-wrap">@ex.ToString()</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>
</main>