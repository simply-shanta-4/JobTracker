@page "/applications/new"
@page "/applications/{Id:int}"
@attribute [Authorize]
@inject IApplicationService Service
@inject NavigationManager Nav

<h1 class="mb-3">@(Id is null ? "Add application" : "Edit application")</h1>

@if (model == null)
{
    <p>Loading...</p>
}
else
{
    <ApplicationForm Model="model"
                     ShowDelete="@(Id is not null)"
                     OnSave="SaveAsync"
                     OnCancel="GoBack"
                     OnDelete="DeleteAsync" />
}

@code {
    [Parameter] public int? Id { get; set; }

    private JobApplication? model;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            model = new JobApplication();
            return;
        }

        var existing = await Service.GetByIdAsync(Id.Value);
        if (existing is null)
        {
            Nav.NavigateTo("board");
            return;
        }

        // Edit a copy so Cancel doesn't change the stored item
        model = new JobApplication
        {
            Id = existing.Id,
            Company = existing.Company,
            Position = existing.Position,
            Location = existing.Location,
            JobUrl = existing.JobUrl,
            Notes = existing.Notes,
            Status = existing.Status,
            AppliedOn = existing.AppliedOn,
            FollowUpOn = existing.FollowUpOn
        };
    }

    private async Task SaveAsync()
    {
        if (model!.Status == ApplicationStatus.Applied && model.AppliedOn is null)
            model.AppliedOn = DateTime.Today;

        if (Id is null)
            await Service.AddAsync(model);
        else
            await Service.UpdateAsync(model);

        GoBack();
    }

    private async Task DeleteAsync()
    {
        await Service.DeleteAsync(model!.Id);
        GoBack();
    }

    private void GoBack() => Nav.NavigateTo("board");
}