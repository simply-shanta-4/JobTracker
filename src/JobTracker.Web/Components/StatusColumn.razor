<div class="board-column">
    <h6 class="d-flex justify-content-between align-items-center mb-3">
        @Status
        <span class="badge bg-secondary">@Applications.Count</span>
    </h6>

    @if (Applications.Count == 0)
    {
        <div class="empty-column text-muted small text-center py-4">
            Nothing here yet
        </div>
    }

    @foreach (var app in Applications)
    {
        <ApplicationCard Application="app"
                         OnMove="newStatus => OnMove(app, newStatus)"
                         OnDelete="() => OnDelete(app)" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ApplicationStatus Status { get; set; }

    [Parameter, EditorRequired]
    public List<JobApplication> Applications { get; set; } = new();

    [Parameter]
    public Func<JobApplication, ApplicationStatus, Task> OnMove { get; set; }
        = (_, _) => Task.CompletedTask;

    [Parameter]
    public Func<JobApplication, Task> OnDelete { get; set; }
        = _ => Task.CompletedTask;
}