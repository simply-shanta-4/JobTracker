<div class="card app-card mb-2 @(Overdue ? "overdue-card" : "")">
    <div class="card-body p-2">
        <div class="fw-semibold">@Application.Company</div>
        <div class="small">@Application.Position</div>
        <div class="small text-muted">@Application.Location</div>

        @if (!string.IsNullOrWhiteSpace(Application.Notes))
        {
            <div class="small text-muted fst-italic notes-preview mt-1" title="@Application.Notes">
                @Application.Notes
            </div>
        }

        @if (Application.FollowUpOn is { } followUp)
        {
            <div class="small mt-1 @(Overdue ? "text-danger fw-semibold" : "text-warning-emphasis")">
                Follow up: @followUp.ToString("dd MMM")
                @if (Overdue)
                {
                    <span>(overdue)</span>
                }
            </div>
        }

        <select class="form-select form-select-sm mt-2"
                value="@Application.Status"
                @onchange="HandleChange">
            @foreach (var s in Enum.GetValues<ApplicationStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <a class="small" href="applications/@Application.Id">Edit</a>
            <button type="button" class="btn btn-link btn-sm text-danger p-0"
                    @onclick="OnDelete">Delete</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public JobApplication Application { get; set; } = default!;

    [Parameter]
    public EventCallback<ApplicationStatus> OnMove { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    // Overdue only counts while you're still waiting to hear back
    private bool Overdue =>
        Application.FollowUpOn is { } due
        && due.Date < DateTime.Today
        && Application.Status is ApplicationStatus.Applied or ApplicationStatus.Interview;

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<ApplicationStatus>(e.Value?.ToString(), out var status))
            await OnMove.InvokeAsync(status);
    }
}